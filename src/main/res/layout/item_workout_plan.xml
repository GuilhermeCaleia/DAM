<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/text_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="60dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        tools:text="Seg" />

    <TextView
        android:id="@+id/text_plan_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:textColor="#444444"
        tools:text="Peito + Tríceps" />

    <TextView
        android:id="@+id/text_muscle_groups"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <View
        android:id="@+id/status_circle"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/circle_pending" />

    <Button
        android:id="@+id/button_mark_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fiz"
        android:minWidth="64dp"
        android:minHeight="36dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        app:cornerRadius="18dp"
        android:textAllCaps="true"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
